# Copy this file to .env and fill in your own values.
# .env is git-ignored. Never commit real keys.

# --- Anthropic / Claude API (all projects) ---
# Get one at: Anthropic Console -> Settings -> API Keys
ANTHROPIC_API_KEY=

# Model used by the lab projects (change if you like)
ANTHROPIC_MODEL=claude-sonnet-4-5

# --- OpenWeather (project 01) ---
# Free key at https://openweathermap.org/api (can take ~2h to activate)
OPENWEATHER_API_KEY=

# --- Google Maps Platform (project 03) ---
# Google Cloud Console -> APIs & Services -> Credentials -> API key
GOOGLE_MAPS_API_KEY=

# --- Tavily (project 05) ---
# Free key at https://app.tavily.com
TAVILY_API_KEY=

# --- Postgres (projects 02, 04, 06) ---
# Matches docker-compose.yml out of the box.
DATABASE_URL=postgresql://lab:lab@localhost:5432/lab

# --- Google OAuth (projects 01 Calendar, 06 Gmail) ---
# These projects use an OAuth "Desktop app" client, not an API key.
# In Google Cloud Console: enable the Calendar and/or Gmail API, then
# Credentials -> Create Credentials -> OAuth client ID (Desktop app) ->
# download the JSON and save it as credentials.json in the project folder.
# First run opens a browser for consent and writes token.json next to it.
# Both files are git-ignored.
GOOGLE_CREDENTIALS_FILE=credentials.json
GOOGLE_TOKEN_FILE=token.json
